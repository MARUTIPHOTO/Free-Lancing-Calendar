rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(studioId) {
      return request.auth != null && (request.auth.uid == studioId || studioId == 'marutiphoto');
    }

    function isValidStudioProfile(data) {
      return data.studioId is string &&
             data.studioName is string && data.studioName.size() > 0 && data.studioName.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30;
    }

    function isValidStudioDate(data) {
      return data.dateKey is string && data.dateKey.size() == 10 &&
             data.status in ['FREE', 'INQUIRY', 'BOOKED'];
    }

    function isValidStudioInquiry(data) {
      return data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 100 &&
             data.clientPhone is string && data.clientPhone.size() > 0 && data.clientPhone.size() <= 30 &&
             data.status in ['PENDING', 'CONFIRMED', 'DECLINED'];
    }

    match /studios/{studioId} {
      allow read: if true;
      allow write: if isOwner(studioId);

      match /dates/{dateKey} {
        allow read: if true;
        allow write: if isOwner(studioId) && isValidStudioDate(request.resource.data);
      }

      match /schedule/{scheduleDoc} {
        allow read: if true;
        allow write: if isOwner(studioId) || studioId == 'marutiphoto';
      }

      match /inquiries/{inquiryId} {
        allow read: if true;
        allow create: if isValidStudioInquiry(request.resource.data) && (isOwner(studioId) || request.resource.data.status == 'PENDING');
        allow update, delete: if isOwner(studioId) || studioId == 'marutiphoto';
      }
    }
  }
}
