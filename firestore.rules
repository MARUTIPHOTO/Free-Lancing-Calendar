rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /studios/{studioId} {
      allow read, write: if true;

      match /dates/{dateKey} {
        allow read, write: if true;
      }

      match /schedule/{scheduleDoc} {
        allow read, write: if true;
      }

      match /inquiries/{inquiryId} {
        allow read, write: if true;
      }

      match /profile/{profileDoc} {
        allow read, write: if true;
      }

      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
